# Copy to .env (which is gitignored) and adjust. Read by docker-compose.yml.
# Every password and secret below ships EMPTY on purpose: docker compose and the
# services refuse to start until you fill them in. Generate each with
#   openssl rand -hex 24      (hex never contains a quote; see the note below)
POSTGRES_USER=kb
POSTGRES_PASSWORD=
POSTGRES_DB=kb_mcp

# Host port for the container's Postgres (loopback only). Defaults to 5433 so it does
# not clash with a Postgres already on 5432.
DB_HOST_PORT=5433

# Docker Compose project name: names the Postgres container (<project>_db) and its data
# volume. Running a second, isolated ego-OS on this machine (e.g. the demo next to your
# real notes)? Give it its own value here, plus its own DB_HOST_PORT and service ports
# below, or it reattaches to the first install's database. See docs/operations.md.
# KB_COMPOSE_PROJECT=kb_mcp

# The kb-mcp app/CLI/dashboard read KB_DATABASE_URL. `kb`/POSTGRES_PASSWORD is the
# bootstrap superuser -- break-glass only, never used by a running service. With
# the KB_APP_* values below:
#   KB_DATABASE_URL=postgresql://kb_app:<KB_APP_PASSWORD>@localhost:5433/kb_mcp

# --- Runtime DB roles (created by db/init/02-roles.sh on first cluster init) ---
# Services connect as the app role, never as the bootstrap superuser.
# Neither password may contain a single quote -- db/init/02-roles.sh interpolates
# them into single-quoted SQL literals, and a failed first init needs
# `docker compose down -v` (wipes the volume) before it can be retried.
KB_APP_USER=kb_app
KB_APP_PASSWORD=
# Test role password (role kb_test, database kb_mcp_test — used by pytest).
# KB_TEST_PASSWORD=kb_test
# The suites connect to KB_TEST_DATABASE_URL (default
# postgresql://kb_test:kb_test@localhost:5433/kb_mcp_test) and TRUNCATE its tables: set it
# in your shell when the password or port above differs, never to a database you care about.
# The suites refuse to start unless that database is a test one (kb_mcp_test*, *_b,
# kb_verify*) and differs from KB_DATABASE_URL. KB_TEST_ALLOW_ANY_DATABASE=1 overrides it.

# --- Inference sizing ---
# Chat model served by Ollama (pulled automatically by kb-dev/kb-run).
OLLAMA_MODEL=gemma4:12b-it-q8_0
# Where Ollama listens. Read by kb-run's model check and by the inference server.
# OLLAMA_BASE_URL=http://localhost:11434
# Skip kb-run's Ollama model check and pulls (models already present, or no Ollama).
# KB_RUN_SKIP_PREFLIGHT=1
# KB_ENRICH_CONCURRENCY=8
# KB_INFERENCE_MAX_CONCURRENCY=2
# KB_INFERENCE_MAX_SESSIONS=256   # in-memory chat sessions kept; oldest dropped first

# --- Service ports (override only on a collision) ---
# Each service binds a loopback port; set these to move one if it's already taken.
# The frontend reads KB_FRONTEND_PORT (its own port) and KB_DASHBOARD_PORT (the
# /api proxy target) at preview start, so both take effect on a frontend restart.
# KB_DASHBOARD_PORT=8000     # dashboard API (backend)
# KB_FRONTEND_PORT=8091      # dashboard web UI (vite preview)
# KB_INFERENCE_PORT=8001     # local model server
# Local model server access. KB_Inference binds 127.0.0.1 and accepts only loopback clients
# and loopback Host headers. Set a token to require `Authorization: Bearer <token>` on every
# endpoint; kb-svc.sh hands this file to the server and to every caller, so one line here
# covers both sides. Remote access needs KB_INFERENCE_HOST, KB_INFERENCE_ALLOW_REMOTE=1 and
# a token (KB_Inference/README.md, "Network exposure").
# KB_INFERENCE_TOKEN=        # e.g. `openssl rand -hex 32`
# KB_INGEST_PORT=8030        # ingest daemon push receiver
# KB_MCP_PORT=3000           # local MCP tool surface

# --- Service identity ---
# launchd label prefix (macOS): services are ${KB_SERVICE_PREFIX}.<name>
# KB_SERVICE_PREFIX=com.kb
# Docker context kb-dev uses for docker/compose (unset = the CLI's current context). Pin it
# when the host runs more than one docker daemon, e.g. colima alongside Docker Desktop.
# KB_DOCKER_CONTEXT=desktop-linux
# Extra dashboard origin(s) allowed for mutating requests (your public front-door).
# A public hostname here or below ALSO needs KB_DASHBOARD_AUTH=cf-access (Hybrid tenancy
# section): without it the API would serve every request as the owner, with no login, so
# it refuses to start.
# KB_DASHBOARD_ORIGINS=https://kb.example.com
# Public hostname(s) the frontend preview accepts (comma-separated).
# KB_FRONTEND_ALLOWED_HOSTS=kb.example.com
# Actor identity stamped on dashboard actions (judgments, tool toggles).
# KB_DASHBOARD_IDENTITY=owner
# Eval data root for your own (private) golden sets. Unset ⇒ committed synthetic sets.
# KB_EVAL_DATA_DIR=/path/to/your/evals

# --- Dashboard Database page (raw Postgres table browser) --------------------
# Shared password gating the dashboard's /api/db/* endpoints (the "Database" tab).
# kb-dev passes it through to kb-dashboard-api. Leave unset to keep that browser
# fully locked (the endpoints return 503); set a value to enable it. The same password
# gates the MCP tool toggles and the Claude re-auth button. It is a second factor, NOT
# authentication: without KB_DASHBOARD_AUTH=cf-access the API serves every request as
# the owner. Five wrong passwords in 5 min from one client address lock the gate for
# 15 min (HTTP 429), right password included.
# Needs 16+ characters and no placeholder: a weak value is ignored (the gate stays locked,
# 503) with a warning on stderr. Generate one: `openssl rand -hex 16`.
# KB_DB_VIEWER_PASSWORD=
# One-click Claude re-auth (macOS only): POST /api/auth/claude/relogin opens a Terminal
# on the host running `claude auth login`. It starts a process on your machine, so it is
# OFF by default (the route returns 404 and the banner shows the command instead).
# Set to 1 to enable; it then also needs KB_DB_VIEWER_PASSWORD and is owner-only.
# KB_DASHBOARD_ALLOW_RELOGIN=1

# --- Ingest daemon (kb-mcp-ingestd) -------------------------------------------
# HMAC key for the push receiver (POST /ingest/<source>). Required while the
# receiver is on: the daemon refuses to start if it is empty, shorter than 32
# characters, or a placeholder. Generate one with:
#   openssl rand -hex 32
# Senders sign a timestamp, the method, the path and the body hash with it (see
# KB_Core/docs/ingestion-architecture.md). The receiver binds 127.0.0.1; keep it there.
KB_INGEST_SECRET=
# Absolute path to the Obsidian vault (or any folder of Markdown) to ingest. If unset,
# the daemon still runs but skips the Obsidian source entirely.
# KB_OBSIDIAN_VAULT=/Users/you/Obsidian/MyVault
# WRITES INTO YOUR NOTES: by default ingest adds one `id:` line to the YAML frontmatter
# of every note it reads, so a note keeps its identity when renamed or moved. Set 0 to
# never modify the notes (identity then follows the file path). Try a copy first.
# KB_OBSIDIAN_STAMP=1
# Top-level folder the notes appear under in the knowledge tree; empty = tree root.
# KB_OBSIDIAN_LAYER=Obsidian
# Per-source toggles (enabled, is_enrichable, period_seconds) live in sources.toml in
# this directory; point elsewhere with an absolute path (the demo uses
# examples/demo-sources.toml, which turns enrichment off).
# KB_SOURCES_CONFIG=/path/to/sources.toml
# Skip embeddings (keyword search only) while keeping the LLM enrichment passes.
# KB_EMBED_ENABLED=0
# Heartbeat: how often the scheduler ticks (scans adapters, fires any that are due).
# Default 20s. A tick prints what ran + each source's countdown.
# KB_TICK_SECONDS=20
# Seconds the ingest/reanalyze clients wait for one KB_Inference /chat turn before giving up
# with "inference call failed: timed out". Default 300. Raise if a slow, queued model needs
# longer; the engine is single-flight, so a turn must outlast any call ahead of it.
# KB_INFERENCE_TIMEOUT=300

# --- Per-install policy ------------------------------------------------------------
# Decay rules, project dormancy, ranking scalars, taxonomy, prompt overlays live in
# KB_Core/policy.toml (gitignored; copy policy.toml.example). Unset ⇒ ./policy.toml,
# missing ⇒ shipped defaults. Point elsewhere with:
# KB_POLICY_CONFIG=/path/to/policy.toml

# --- LLM routing ---------------------------------------------------------------
# Which backend answers each inference task now lives in KB_Core/inference.toml
# (one [task.<name>] block per task; fail-loud if incomplete — see
# kb_core/inference_routing.py). The old routing env vars — KB_INFERENCE_PROVIDER,
# KB_CONCEPT_LABEL_PROVIDER, KB_CONCEPT_LABEL_MODEL, KB_ANTHROPIC_MODEL,
# KB_CLAUDE_CLI_MODEL — are RETIRED: set ones only draw a startup warning.
# The shipped routing sends 7 tasks to claude-cli: their note text goes to Anthropic
# under your own Claude Code login (README, "Enrichment providers").
# Use another routing file (an absolute path is safest):
# KB_INFERENCE_ROUTING=inference.toml
# Env still owns transport + secrets:
# ANTHROPIC_API_KEY=sk-ant-...            # only for provider=anthropic tasks
# Services get KB_INFERENCE_URL=http://127.0.0.1:$KB_INFERENCE_PORT from kb-svc.sh; set
# it yourself only for tools you run by hand (kb-embed-backfill, the eval harnesses).
# KB_INFERENCE_URL=http://127.0.0.1:8001

# --- Public MCP listener (mcp-public → your public MCP hostname) ---
# Auth mode for the internet-exposed MCP listener on :3100. The local listener on
# :3000 never reads this (kb-svc.sh maps it to KB_MCP_AUTH only for mcp-public).
# Bind address of the local, unauthenticated MCP listener (default 127.0.0.1). kb-mcp
# refuses a non-loopback value without KB_MCP_AUTH: remote access goes through mcp-public.
# KB_MCP_HOST=127.0.0.1
# Write tools on the PUBLIC listener (mcp-public :3100). Unset/empty/off = none: a remote
# caller, or a model acting on injected note text, cannot add, edit, move or delete.
# `all` (or an on-word) = every write tool except the library writes below; otherwise a
# comma list of tool names (a typo, or a library write tool, fails startup). Recursive
# delete is always refused there. The local :3000 ignores it.
# KB_MCP_PUBLIC_WRITE_TOOLS=
# Skill/agent library writes (upsert_*, delete_*, review_*) on the public listener. Off
# unless 1/true/yes/on: a remote library write plants instructions every agent and synced
# device loads. The local :3000 ignores it.
# KB_MCP_PUBLIC_LIBRARY_WRITES=
# Per-caller write budget on the public listener: <n>/<unit> (second, minute, hour, day).
# Each write runs the enrichment passes on your inference provider. Unset = 60/hour;
# off = no limit. Note bodies over 1 MiB are refused on both listeners.
# KB_MCP_PUBLIC_WRITE_RATE=60/hour
# Unset ⇒ the public service refuses to start. Modes:
#   cf-access        → validate Cloudflare Access JWTs
#   internal-secret  → require the X-KB-MCP-Internal header set by a proxy you run
# Setup: docs/exposure.md.
# KB_MCP_PUBLIC_AUTH=cf-access
# KB_MCP_PUBLIC_PORT=3100
# cf-access: Zero Trust team domain, the Access app's audience (aud) tag, and the
# comma-separated email allowlist.
# KB_CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# KB_CF_ACCESS_AUD=<the Access application's audience tag>
# KB_CF_ACCESS_EMAILS=you@example.com
# internal-secret: openssl rand -hex 32, mirrored into `wrangler secret put KB_MCP_INTERNAL_SECRET`.
# KB_MCP_INTERNAL_SECRET=
# Host header the tunnel delivers to the public listener; build_server() adds it
# to FastMCP's DNS-rebinding allowlist (without it every authed request is 421).
# mcp-public only: the plain `mcp` listener (no auth) drops it, and kb-mcp refuses
# to start with a public hostname but no auth mode.
# KB_MCP_PUBLIC_HOSTNAME=kb-mcp.example.com

# --- Service extensions (your own sources) ------------------------------------
# Extra services for kb-dev / kb-svc.sh to supervise, e.g. a sync you wrote that drops
# notes into the vault. Colon-separated bash files, absolute or relative to the checkout
# root; each appends its names to KB_EXTRA_SERVICES and defines kb_svc_<name> (see the
# "Service extensions" block in KB_Core/scripts/kb-svc.sh).
# KB_SERVICE_EXTENSIONS=my-sources/chat-sync.sh

# --- Alerts (kb-healthcheck) ----------------------------------------------------
# macOS notifications are always on. Set both to ALSO send each alert to Pushover:
# the alert text then goes to api.pushover.net.
# KB_PUSHOVER_TOKEN=
# KB_PUSHOVER_USER=

# --- Hybrid tenancy (hosting other people; not needed for a single user) ---------------
# The tenant registry (owner + [tenant.<slug>] blocks: emails, kb_t_<slug> database,
# agent_secret). Gitignored, never published. Unset ⇒ ./tenants.toml; absent ⇒ owner only.
# KB_TENANTS_CONFIG=/path/to/tenants.toml
# Max connections per TENANT pool (the owner's pools keep their own knobs, e.g.
# KB_MCP_POOL_MAX). Each service opens one pool per tenant it serves.
# KB_TENANT_POOL_MAX=4
# Dashboard auth: cf-access ⇒ every API request needs a valid Access JWT whose email the
# registry maps to a tenant (unknown email = 403). Unset ⇒ serves KB_TENANT (default owner)
# with no auth — local-only use, owner-only registries only: with any enabled tenant the API
# refuses to start unless this is cf-access. Uses KB_CF_ACCESS_TEAM_DOMAIN plus the DASHBOARD Access
# application's own audience tag (not the MCP app's KB_CF_ACCESS_AUD). A non-local hostname
# in KB_DASHBOARD_ORIGINS / KB_FRONTEND_ALLOWED_HOSTS / KB_API_ALLOWED_HOSTS also needs
# cf-access, or the API refuses to start; `none` = no login, but another gate in front of
# the API verifies every request (starts with a warning). Any other value is refused.
# KB_DASHBOARD_AUTH=cf-access
# KB_CF_ACCESS_AUD_DASHBOARD=<the dashboard Access application's audience tag>
# Agent gateway (agent-gateway service): the only surface a tenant's kb-agent talks to.
# KB_GATEWAY_PORT=8040
# Public URL of the gateway, printed in the onboarding bundle by `kb-tenant create`.
# KB_GATEWAY_URL=https://kb-agent.example.com
# Backups (backup service, every KB_BACKUP_INTERVAL s, default 86400): age-encrypted
# pg_dump per registry database. The recipient is REQUIRED (age-keygen -o ~/kb-backup-key.txt,
# outside the repo; keep that key file off this machine). Unset dir ⇒ ~/Library/Application
# Support/kb/backups on macOS, $XDG_DATA_HOME/kb/backups (normally ~/.local/share/kb/backups) elsewhere.
# KB_BACKUP_AGE_RECIPIENT=age1...
# KB_BACKUP_DIR=/path/to/backups
# Tenant daemons (provider `agent`): how long a queued llm_jobs completion is waited on
# before provider `agent` pauses (seconds; overrides inference.tenant.toml's
# [provider.agent] timeout and rides on each job as its deadline), and how long that pause
# lasts (minutes). The gateway reclaims an unreported claim after the agent's own 300 s run
# timeout + 60 s (kb_core.llm_jobs.STALE_CLAIM_S), inside this window.
# KB_AGENT_JOB_TIMEOUT=600
# KB_AGENT_PAUSE_MINUTES=15
