# Copy to .env.tunnel and fill in your values.
# tunnel.sh only ever forwards to the AUTHENTICATED mcp-public listener: set
# KB_MCP_PUBLIC_AUTH (and its settings) plus KB_MCP_PUBLIC_HOSTNAME in KB_Core/.env
# first. It refuses the plain, unauthenticated mcp port (3000).
CF_TUNNEL_NAME=my-kb-tunnel
CF_HOSTNAME=kb-mcp.example.com    # must equal KB_MCP_PUBLIC_HOSTNAME
MCP_PUBLIC_PORT=3100              # the mcp-public port (KB_MCP_PUBLIC_PORT); never 3000
