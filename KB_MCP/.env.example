# Copy to .env (gitignored) and adjust. The MCP server is a thin client of the
# KB_Core engine; it connects to the SAME Postgres that KB_Core owns.
#
# Bring the database up from KB_Core (./scripts/kb-dev.sh) — the POSTGRES_*/
# docker-compose settings live there, not here.

# Connection string for that database, as the unprivileged app role (KB_APP_USER /
# KB_APP_PASSWORD + DB_HOST_PORT in KB_Core/.env) -- never the `kb` bootstrap superuser.
# Only needed when you run the server by hand: KB_Core/scripts/kb-svc.sh derives this
# from KB_Core/.env for every service it starts.
KB_DATABASE_URL=postgresql://kb_app:<KB_APP_PASSWORD>@localhost:5433/kb_mcp

# Optional: absolute path to an Obsidian vault. If set, the `sync_source` tool can
# ingest it; if unset, that tool is simply unavailable.
# KB_OBSIDIAN_VAULT=/Users/you/Obsidian/MyVault
