# STANDALONE USE ONLY: `uvicorn server:app --env-file .env` (see README.md).
# Under kb-run / kb-dev the inference service never reads this file: it gets its settings
# from KB_Core/.env and its port from KB_INFERENCE_PORT (default 8001).

# Ollama / model settings
OLLAMA_MODEL=gemma4:12b-it-q8_0
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model (served by the same Ollama instance, alongside OLLAMA_MODEL). Pull it with
# `ollama pull qwen3-embedding:0.6b`. Native output is 1024-dim.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Optional Matryoshka truncation: return fewer than the native dims (smaller/faster vectors,
# slightly lower quality). Unset = native dimensionality.
# OLLAMA_EMBED_DIMENSIONS=512
# Context window for the embedding runner. Its native 32k window reserved 4.0GB for a
# 595M-param model while inputs are clipped to ~1,500 tokens anyway. 0 = model default.
OLLAMA_EMBED_NUM_CTX=2048
# Low sampling for stable, repeatable enrichment output (not greedy 0 — avoids loops).
OLLAMA_TEMPERATURE=0.3
# Fixed seed makes a given (prompt, temperature) reproducible across calls.
OLLAMA_SEED=0
# Keep the model resident between requests so sweeps don't pay a cold reload. -1 pins it; also
# accepts e.g. "30m", or "0" to unload immediately.
OLLAMA_KEEP_ALIVE=-1
# Context window. Unset = model default (16,384 for gemma4:26b, as reported by
# `ollama ps`). Lower it to shrink the KV cache / memory use, but only if your inputs are
# small — it truncates long documents.
# OLLAMA_NUM_CTX=8192
# Max tokens the model may generate per turn. Bounds degenerate decode loops (a runaway
# reply runs past the caller's 300s timeout and is discarded anyway). This counts
# TOTAL generated tokens including gemma4:26b's chain-of-thought, which the logged reply-char
# figure excludes -- sizing this cap from reply chars alone silently starves the model of
# room to finish thinking before it emits any output. Measured uncapped, a typical
# extract_entities call runs ~2,200-3,300 tokens total; 8192 clears that with margin while
# still catching the runaways (>10,800 content tokens alone). 0 = uncapped.
OLLAMA_NUM_PREDICT=8192
# Chain-of-thought on/off (Ollama's `think`; ChatOllama calls it `reasoning`). TRI-STATE:
# leave it unset and the MODEL decides, which is not the same as `false`. gemma4 thinks by
# default, and extraction quality depends on it, so unset is the right production setting.
# Read once at process start -- changing it needs a restart. Use the tool, which writes,
# restarts and verifies through /health:  KB_Core/scripts/kb-model.sh use TAG --think on|off
# Cost, measured: one extract_entities call runs 100-175s with thinking on and
# ~7s with it off, and thinking tokens are what exhaust OLLAMA_NUM_CTX in the runaway cases.
# OLLAMA_THINK=
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# HTTP server settings
# Bind address (KB_INFERENCE_HOST, falling back to HOST). Anything but loopback is refused
# unless KB_INFERENCE_ALLOW_REMOTE=1, which in turn requires KB_INFERENCE_TOKEN.
KB_INFERENCE_HOST=127.0.0.1
PORT=8001                         # the stack's port; 8000 is the dashboard API
# KB_INFERENCE_TOKEN=            # when set, every endpoint requires `Authorization: Bearer <token>`
# KB_INFERENCE_ALLOW_REMOTE=0    # 1 = accept non-loopback binds and clients (token required)
# KB_INFERENCE_ALLOWED_HOSTS=    # extra Host-header names, comma-separated (loopback always allowed)
# KB_INFERENCE_DEBUG_SESSIONS=0  # 1 = serve GET /sessions[/{id}] (returns prompts + history)

# Logging. INFO logs one start + one done line per inference (with latency); DEBUG also
# logs capped previews of each prompt and reply.
LOG_LEVEL=INFO
